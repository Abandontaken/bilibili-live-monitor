APP_HOST=127.0.0.1
APP_PORT=8765
# 根路径以 / 表示，运行时归一为空前缀
APP_ROOT_PATH=/
CDP_URL=http://127.0.0.1:9222
ASR_PYTHON=.venvs/asr/bin/python
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
DATA_DIR=.local
CAPTURE_BACKEND=cdp
RECORD_MODE=audio
# direct 模式下 AUDIO_FORMAT 默认为 opus（32k），cdp 模式下默认为 wav
# AUDIO_FORMAT=opus
# AUDIO_BITRATE=32k
# DIRECT_AUDIO_QN=80
# DIRECT_VIDEO_QN=10000
# DIRECT_HANDSHAKE_INTERVAL=2.5
ASR_ENABLED=0
PREVIEW_ENABLED=0
RECORDING_SEGMENT_SECONDS=300
# 实时ASR固定每5秒输入，模型音频上下文上限30秒；无独立切片或静音跳过。
MAX_ROOMS=10
QUEUE_SIZE=20
MAX_RECONNECTS=20
RETRY_DELAY=2
RETRY_MAX_DELAY=300
WATCH_POLL_SECONDS=30
GUARD_POLL_SECONDS=3600
HF_HUB_OFFLINE=0
